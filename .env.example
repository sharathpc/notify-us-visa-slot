# Copy this file to .env and replace the placeholder API key.
VISA_API_KEY=replace-with-your-checkvisaslots-api-key
VISA_POLL_INTERVAL_SECONDS=60
VISA_ZERO_SLOTS_HEARTBEAT_MINUTES=30

# ntfy push notifications: subscribe to this topic in the ntfy iPhone app.
# Use a private topic with the ntfy server's access controls if authentication is required.
VISA_NTFY_TOPIC_URL=https://ntfy.sh/replace-with-a-long-random-topic
VISA_NTFY_AVAILABILITY_PRIORITY=5
VISA_NTFY_HEARTBEAT_PRIORITY=1

# Optional settings:
# VISA_API_BASE_URL=https://app.checkvisaslots.com
# VISA_EXT_VERSION=5.1.5
# VISA_LOG_LEVEL=INFO
